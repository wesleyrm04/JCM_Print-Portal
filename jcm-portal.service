# Linux / Proxmox service. (On Windows use the .bat launchers instead - see SECURITY.md section 6.)
# v6: no longer runs as root. One-time setup:
#   useradd --system --home /opt/print-portal --shell /usr/sbin/nologin jcm
#   chown -R jcm:jcm /opt/print-portal/data      (and the NAS orders folder must be writable by user jcm)
#   Port 80 is allowed through CAP_NET_BIND_SERVICE below, so root is not needed.
[Unit]
Description=JCM Print Portal
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/print-portal
ExecStart=/opt/print-portal/venv/bin/python server.py
# 80 = shop network, 1013 = the port your tunnel points at (refused for /admin and the POS API)
Environment=JCM_PORT=80,1013
Environment=JCM_PUBLIC_PORTS=1013
# Environment=JCM_ADMIN_NETWORKS=127.0.0.1/32,10.0.4.37/32
User=jcm
Group=jcm
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
UMask=0077
# the only places the portal may write: its own data folder and the NAS orders folder
ReadWritePaths=/opt/print-portal/data /mnt/nas_spool
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
