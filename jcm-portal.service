[Unit]
Description=JCM Print Portal
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/print-portal
ExecStart=/opt/print-portal/venv/bin/python server.py
Environment=JCM_PORT=80,1013
AmbientCapabilities=CAP_NET_BIND_SERVICE
User=root
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target